{
  "name": "corelab",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run validate:content && npm test && npm run build",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:lab": "node scripts/verify-lab.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "lint": "eslint .",
    "format": "prettier --write app components lib scripts tests e2e *.ts *.mjs package.json"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@xyflow/react": "^12.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "katex": "$katex"
  }
}
