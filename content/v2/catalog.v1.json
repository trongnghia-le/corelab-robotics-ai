    {
      "id": "CPP02.ring-buffer",
      "topicId": "CPP02",
      "title": "C++ sensor ring buffer",
      "instructions": "Implement a fixed-capacity FIFO in C++. Choose overwrite-oldest or reject-new policy and state it. Cover zero capacity, empty/partial/wrapped state, copy independence and self-assignment. std::deque may satisfy behavior but does not prove manual memory ownership. Run only your own trusted code locally; CoreLab never compiles it.",
      "status": "manual-unverified"
    }
