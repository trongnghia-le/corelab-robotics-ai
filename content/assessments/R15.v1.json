    {
      "id": "q1",
      "prompt": "A link's first natural frequency is 30 Hz and the controller bandwidth is 25 Hz. Is a rigid-body model of the link appropriate?",
      "kind": "choice",
      "dimension": "C",
      "critical": true,
      "knowledgeType": "concept",
      "skillTags": [
        "rigid-validity"
      ],
      "skillLabel": "Rigid-model validity",
      "mistakeCategory": "conceptual",
      "remediationRefs": [
        {
          "label": "Review: Rigid-model validity",
          "href": "/lessons/R15#theory-and-derivation"
        }
      ],
      "relatedPrerequisites": [
        "R12",
        "R14"
      ],
      "options": [
        "Yes, because the 25 Hz bandwidth is below the 30 Hz natural frequency",
        "No: excitation is close to the resonance and the amplification is large",
        "Yes, provided the link is made of aluminium, which is stiff enough",
        "Only at DC, where no link motion at all is excited by the controller"
      ],
      "answer": "1",
      "explanation": "Rigid models need excitation well below the first mode (rule of thumb < fn/3)."
    },
