  "questions": [
    {
      "id": "q1",
      "prompt": "Why can the joint torques of a floating-base robot not directly command the base acceleration?",
      "kind": "choice",
      "dimension": "C",
      "critical": true,
      "knowledgeType": "concept",
      "skillTags": [
        "underactuation"
      ],
      "skillLabel": "Underactuated base",
      "mistakeCategory": "conceptual",
      "remediationRefs": [
        {
          "label": "Review: Underactuated base",
          "href": "/lessons/R11#theory-and-derivation"
        }
      ],
      "relatedPrerequisites": [
        "R07",
        "R08"
      ],
      "options": [
        "Joint torques are too small compared with gravity, so the base can only be moved by larger external motors",
        "Motors cannot produce torque while the feet are in the air, so the base is uncontrolled in flight",
        "The base rows of the equation of motion have no joint-torque term; the base moves only via contact forces and couplings",
        "The base is massless in the model, so its acceleration is fixed by the leg dynamics alone"
      ],
      "answer": "2",
      "explanation": "S^T tau only selects actuated joints, so the base rows have no tau term."
    },
