      "id": "q2",
      "kind": "number",
      "prompt": "Compute the relative condition number of f(x)=x-1 at x=1.002 (nearest integer).",
      "answer": "501",
      "dimension": "M",
      "critical": false,
      "tolerance": 1,
      "explanation": "kappa=|x f'(x)/f(x)|=1.002/0.002=501."
