      "skillLabel": "Points versus directions",
      "mistakeCategory": "conceptual",
      "remediationRefs": [
        {
          "label": "Review the lesson section",
          "href": "/lessons/M12#theory-and-derivation"
        }
      ],
      "prompt": "In homogeneous coordinates which statement is correct?",
      "dimension": "C",
      "critical": true,
      "options": [
        "A direction has last coordinate 1 because it is a unit vector",
        "A point has last coordinate 1 and a direction has last coordinate 0",
        "The last coordinate is always the distance from the origin",
        "Both points and directions have last coordinate 1"
      ],
      "answer": "1",
      "explanation": "The last coordinate switches the translation column on (points) or off (directions)."
    },
