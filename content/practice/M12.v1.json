      "prompt": "For a proper rotation matrix R, which is true?",
      "dimension": "C",
      "critical": false,
      "options": [
        "R⁻¹ = R",
        "R⁻¹ = −R",
        "R⁻¹ = R / det R²",
        "R⁻¹ = Rᵀ"
      ],
      "answer": "3",
      "explanation": "Orthonormal columns give RᵀR = I."
