    {
      "id": "b1",
      "prompt": "For x' = x^3 and x' = -x^3 the linearization about 0 is identical (slope 0). Which statement is true?",
      "kind": "choice",
      "dimension": "C",
      "critical": true,
      "knowledgeType": "concept",
      "skillTags": [
        "linearization-stability"
      ],
      "skillLabel": "Stability from linearization",
      "mistakeCategory": "conceptual",
      "remediationRefs": [
        {
          "label": "Review: Stability from linearization",
          "href": "/lessons/C02#failure-modes"
        }
      ],
      "relatedPrerequisites": [
        "C01",
        "M07",
        "M03"
      ],
      "equivalentTo": [
        "q1"
      ],
      "options": [
        "They behave differently: one is unstable, one is stable; the linear model cannot tell",
        "Both are unstable, since a zero slope gives no restoring force",
        "The linearization shows both are centres, since the slope is zero",
        "Both are stable, since the linearization has slope 0 and so no growth"
      ],
      "answer": "0",
      "explanation": "The cubic term decides; x' = x^3 blows up, x' = -x^3 decays."
    },
