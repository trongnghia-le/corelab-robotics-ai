      "id": "b1",
      "prompt": "A 10 kg crate is pulled with 30 N on a floor with mu_s = 0.5. It does not move. Which statement is correct?",
      "kind": "choice",
      "dimension": "C",
      "critical": true,
      "knowledgeType": "concept",
      "skillTags": [
        "static-vs-limit-friction"
      ],
      "skillLabel": "Static friction is a reaction",
      "mistakeCategory": "conceptual",
      "remediationRefs": [
        {
          "label": "Review: Static friction is a reaction",
          "href": "/lessons/R08#worked-example"
        }
      ],
      "relatedPrerequisites": [
        "R01",
        "R07"
      ],
      "equivalentTo": [
        "q1"
      ],
      "options": [
        "Friction is 49.05 N, equal to mu_s times the normal force",
        "Friction is 30 N and the crate is below breakaway",
        "Friction is 0 N because the crate has no velocity",
        "The crate must be sliding slowly at constant speed"
      ],
      "answer": "1",
      "explanation": "mu_s N = 49.05 N exceeds 30 N, so friction equals the applied 30 N."
    },
